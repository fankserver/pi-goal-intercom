{
  "name": "pi-goal-intercom",
  "version": "0.4.0",
  "description": "Pi extension: start and cancel pi-goal managed runs from intercom messages (GOAL:START / GOAL:CANCEL), with status replies back to the sender.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "goal",
    "intercom",
    "automation"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fankserver/pi-goal-intercom.git"
  },
  "bugs": {
    "url": "https://github.com/fankserver/pi-goal-intercom/issues"
  },
  "homepage": "https://github.com/fankserver/pi-goal-intercom#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && node test/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.6.0"
  }
}
